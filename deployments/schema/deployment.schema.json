{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palissage.net/schema/deployment.schema.json",
  "title": "Palissage 1.1.0 deployment manifest",
  "description": "Version 2 public release record for Arbitrum Sepolia or Robinhood Testnet. Structural validation is separate from receipt, runtime, wiring and explorer source verification. A verified record is not an independent security audit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deploymentId",
    "chainId",
    "protocolVersion",
    "status",
    "verifiedAtBlock",
    "verification",
    "deployer",
    "explorerUrl",
    "contracts",
    "runtimeCodeHashes",
    "assets",
    "roleGrants"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "deploymentId": {
      "type": "string",
      "pattern": "^palissage-(421614|46630)-v1\\.1\\.0$"
    },
    "chainId": {
      "enum": [
        421614,
        46630
      ]
    },
    "protocolVersion": {
      "const": "1.1.0"
    },
    "status": {
      "const": "verified"
    },
    "verifiedAtBlock": {
      "$ref": "#/$defs/uint"
    },
    "verification": {
      "type": "string",
      "minLength": 1
    },
    "deployer": {
      "$ref": "#/$defs/address"
    },
    "explorerUrl": {
      "$ref": "#/$defs/httpsUrl"
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trustedIssuersRegistry",
        "identityRegistry",
        "wineLotToken",
        "primaryMarket",
        "secondaryMarket",
        "redemptionManager",
        "testEURe",
        "claimIssuer",
        "roleGateway",
        "palissageLens"
      ],
      "properties": {
        "trustedIssuersRegistry": {
          "allOf": [
            {
              "$ref": "#/$defs/deployedContract"
            },
            {
              "properties": {
                "name": {
                  "const": "TrustedIssuersRegistry"
                }
              }
            }
          ]
        },
        "identityRegistry": {
          "allOf": [
            {
              "$ref": "#/$defs/deployedContract"
            },
            {
              "properties": {
                "name": {
                  "const": "IdentityRegistry"
                }
              }
            }
          ]
        },
        "wineLotToken": {
          "allOf": [
            {
              "$ref": "#/$defs/deployedContract"
            },
            {
              "properties": {
                "name": {
                  "const": "WineLotToken"
                }
              }
            }
          ]
        },
        "primaryMarket": {
          "allOf": [
            {
              "$ref": "#/$defs/deployedContract"
            },
            {
              "properties": {
                "name": {
                  "const": "PrimaryMarket"
                }
              }
            }
          ]
        },
        "secondaryMarket": {
          "allOf": [
            {
              "$ref": "#/$defs/deployedContract"
            },
            {
              "properties": {
                "name": {
                  "const": "SecondaryMarket"
                }
              }
            }
          ]
        },
        "redemptionManager": {
          "allOf": [
            {
              "$ref": "#/$defs/deployedContract"
            },
            {
              "properties": {
                "name": {
                  "const": "RedemptionManager"
                }
              }
            }
          ]
        },
        "testEURe": {
          "allOf": [
            {
              "$ref": "#/$defs/deployedContract"
            },
            {
              "properties": {
                "name": {
                  "const": "TestEURe"
                }
              }
            }
          ]
        },
        "claimIssuer": {
          "allOf": [
            {
              "$ref": "#/$defs/deployedContract"
            },
            {
              "properties": {
                "name": {
                  "const": "ClaimIssuer"
                }
              }
            }
          ]
        },
        "roleGateway": {
          "allOf": [
            {
              "$ref": "#/$defs/deployedContract"
            },
            {
              "properties": {
                "name": {
                  "const": "RoleGateway"
                }
              }
            }
          ]
        },
        "palissageLens": {
          "allOf": [
            {
              "$ref": "#/$defs/deployedContract"
            },
            {
              "properties": {
                "name": {
                  "const": "PalissageLens"
                }
              }
            }
          ]
        }
      }
    },
    "runtimeCodeHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trustedIssuersRegistry",
        "identityRegistry",
        "wineLotToken",
        "primaryMarket",
        "secondaryMarket",
        "redemptionManager",
        "testEURe",
        "claimIssuer",
        "roleGateway",
        "palissageLens"
      ],
      "properties": {
        "trustedIssuersRegistry": {
          "$ref": "#/$defs/hash"
        },
        "identityRegistry": {
          "$ref": "#/$defs/hash"
        },
        "wineLotToken": {
          "$ref": "#/$defs/hash"
        },
        "primaryMarket": {
          "$ref": "#/$defs/hash"
        },
        "secondaryMarket": {
          "$ref": "#/$defs/hash"
        },
        "redemptionManager": {
          "$ref": "#/$defs/hash"
        },
        "testEURe": {
          "$ref": "#/$defs/hash"
        },
        "claimIssuer": {
          "$ref": "#/$defs/hash"
        },
        "roleGateway": {
          "$ref": "#/$defs/hash"
        },
        "palissageLens": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eur",
        "usdg"
      ],
      "properties": {
        "eur": {
          "allOf": [
            {
              "$ref": "#/$defs/asset"
            },
            {
              "properties": {
                "symbol": {
                  "const": "tEURe"
                },
                "decimals": {
                  "const": 18
                }
              }
            }
          ]
        },
        "usdg": {
          "allOf": [
            {
              "$ref": "#/$defs/asset"
            },
            {
              "properties": {
                "symbol": {
                  "const": "USDG"
                },
                "decimals": {
                  "const": 6
                }
              }
            }
          ]
        }
      }
    },
    "roleGrants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract",
          "role",
          "account"
        ],
        "properties": {
          "contract": {
            "enum": [
              "trustedIssuersRegistry",
              "identityRegistry",
              "wineLotToken",
              "primaryMarket",
              "secondaryMarket",
              "redemptionManager",
              "testEURe",
              "claimIssuer",
              "roleGateway",
              "palissageLens"
            ]
          },
          "role": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "account": {
            "$ref": "#/$defs/address"
          }
        }
      }
    }
  },
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "not": {
        "const": "0x0000000000000000000000000000000000000000"
      }
    },
    "hash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "uint": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "deployedContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "address",
        "creationTx",
        "creationBlock",
        "constructorArgs",
        "abiHash",
        "runtimeCodeHash",
        "compiler",
        "sourceHashes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "$ref": "#/$defs/address"
        },
        "creationTx": {
          "$ref": "#/$defs/hash"
        },
        "creationBlock": {
          "$ref": "#/$defs/uint"
        },
        "constructorArgs": {
          "type": "string",
          "pattern": "^0x([0-9a-fA-F]{2})*$"
        },
        "abiHash": {
          "$ref": "#/$defs/hash"
        },
        "runtimeCodeHash": {
          "$ref": "#/$defs/hash"
        },
        "compiler": {
          "const": "0.8.28+commit.7893614a"
        },
        "sourceHashes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(src|lib)/.+\\.sol$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/hash"
          }
        },
        "explorerSourceVerified": {
          "type": "boolean"
        },
        "explorerVerificationKind": {
          "enum": ["exact-match", "similar-match"]
        },
        "sourceExplorerUrl": {
          "$ref": "#/$defs/httpsUrl"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "explorerSourceVerified"
            ],
            "properties": {
              "explorerSourceVerified": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "sourceExplorerUrl"
            ]
          }
        }
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "symbol",
        "decimals",
        "primaryAllowed",
        "secondaryAllowed"
      ],
      "properties": {
        "address": {
          "$ref": "#/$defs/address"
        },
        "symbol": {
          "type": "string"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "primaryAllowed": {
          "const": true
        },
        "secondaryAllowed": {
          "const": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "chainId": {
            "const": 421614
          }
        }
      },
      "then": {
        "properties": {
          "deploymentId": {
            "const": "palissage-421614-v1.1.0"
          },
          "assets": {
            "properties": {
              "usdg": {
                "properties": {
                  "address": {
                    "const": "0xFFC95faa3d63Cde504a05B567C600B78C0b41892"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "chainId": {
            "const": 46630
          }
        }
      },
      "then": {
        "properties": {
          "deploymentId": {
            "const": "palissage-46630-v1.1.0"
          },
          "assets": {
            "properties": {
              "usdg": {
                "properties": {
                  "address": {
                    "const": "0x7E955252E15c84f5768B83c41a71F9eba181802F"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
